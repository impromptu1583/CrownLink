// Version resource for CrownLink.snp; values come from the generated crownlink/version.h
#include "crownlink/version.h"

1 VERSIONINFO
FILEVERSION    CL_VERSION_MAJOR,CL_VERSION_MINOR,CL_VERSION_PATCH,0
PRODUCTVERSION CL_VERSION_MAJOR,CL_VERSION_MINOR,CL_VERSION_PATCH,0
FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
FILEFLAGS      0x1L
#else
FILEFLAGS      0x0L
#endif
FILEOS         0x40004L
FILETYPE       0x2L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "CrownLink SNP module for StarCraft 1.16.1"
            VALUE "FileVersion",      CL_VERSION_STRING
            VALUE "InternalName",     "CrownLink"
            VALUE "OriginalFilename", "CrownLink.snp"
            VALUE "ProductName",      "CrownLink"
            VALUE "ProductVersion",   CL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END